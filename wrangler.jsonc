{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Cloudflare Worker for the Lumi Derm site.
	// Serves ./lumi-derm-website as static assets, and runs src/worker.js
	// for /api/* and /admin/api/* routes (marketing email sending,
	// subscribers, campaign admin + unsubscribe).
	"name": "lumiderm",
	// The site's Cloudflare account (info@lumidermaesthetics.co.uk). Pinning it here
	// means `wrangler` always targets the right account even when the CLI is logged
	// into more than one — so `d1 migrations apply` no longer hits "database not found".
	"account_id": "31f4dd95e52a8ca9deba2fd43f5a7f43",
	"main": "src/worker.js",
	"compatibility_date": "2026-06-28",
	"assets": {
		"directory": "./lumi-derm-website",
		"not_found_handling": "404-page",
		"binding": "ASSETS",
		// Run the Worker first for API routes so requests return JSON instead of
		// the static admin HTML page.
		"run_worker_first": ["/api/*", "/admin/api/*", "/media/*"]
	},
	// Unsubscribed addresses. Created with:
	//   npx wrangler kv namespace create SUPPRESSION
	// then paste the returned id below.
	"kv_namespaces": [
		{
			"binding": "SUPPRESSION",
			"id": "9499ca19ed66407f9c733c5decf741d0"
		}
	],
	// Newsletter subscribers (personal data). Apply the schema with:
	//   npx wrangler d1 migrations apply lumidermdb --remote
	"d1_databases": [
		{
			"binding": "SUBSCRIBERS",
			"database_name": "lumidermdb",
			"database_id": "0263c49f-0baa-416b-a885-b80e21ab54b2",
			"migrations_dir": "migrations"
		}
	],
	// Uploaded images (offer photos, email banners). Create the bucket once with:
	//   npx wrangler r2 bucket create lumiderm-media
	// Served publicly by the Worker at /media/<key>.
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "lumiderm-media"
		}
	],
	// FROM_EMAIL must be on the domain verified in Resend.
	// REPLY_TO must be a mailbox she actually reads — info@ is the one
	// wired to Namecheap forwarding and named in the DMARC record.
	"vars": {
		"FROM_EMAIL": "Lumi Derm Aesthetics <info@lumidermaesthetics.com>",
		"REPLY_TO": "info@lumidermaesthetics.com",
		// Used by the scheduled (cron) sender to build unsubscribe links,
		// since a cron run has no incoming request URL.
		"SITE_ORIGIN": "https://lumidermaesthetics.com",
		// Second layer of admin protection: even a valid Cloudflare Access user
		// can only use the admin API if their email is in this list. Must match
		// the addresses in the Access Allow policy exactly. Not a secret — these
		// are just email addresses — so it lives here in config, not in secrets.
		"ADMIN_EMAILS": "dima.vasiliu@yahoo.com,info@lumidermaesthetics.co.uk",
		// GitHub repo the admin publishes to. The token itself is the GITHUB_TOKEN
		// secret (never here). Repo/branch aren't secrets, so they live in config.
		"GITHUB_REPO": "DimaVasiliu/LumiDerm",
		"GITHUB_BRANCH": "main"
	},
	// Hourly cron: sends any due scheduled campaigns and, at the birthday
	// send-hour, the day's birthday emails. Handled by scheduled() in the Worker.
	"triggers": {
		"crons": ["0 * * * *"]
	},
	// Exposes the deployment id/tag to the Worker (shown in the admin System status).
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"enabled": true
	}
	// Secrets are NOT stored here. Set them once with:
	//   npx wrangler secret put RESEND_API_KEY
	//   npx wrangler secret put UNSUB_SECRET
}
